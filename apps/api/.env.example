# AWS S3 + Cloudflare R2
R2_BUCKET_NAME=ansoegningsplatform
TOKEN_VALUE=<token-value>
ACCESS_KEY_ID=<access-key-id>
ACCESS_KEY=<access-key>
R2_ENDPOINT=https://25415513eb37a161b1fbfa146ff27475.eu.r2.cloudflarestorage.com
PUBLIC_URL=https://ansoegning.skilteplanen.dk

# Authentication
AUTH_JWT_SECRET=<jwt-secret>
AUTH_JWT_ISSUER=ansoegningsplatformen-api
AUTH_JWT_AUDIENCE=ansoegningsplatformen-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_ONBOARDING_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_ACCESS_COOKIE_NAME=sk_access
AUTH_REFRESH_COOKIE_NAME=sk_refresh
AUTH_ACCESS_COOKIE_PATH=/api
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_COOKIE_SECURE=false

# Signicat
SIGNICAT_ENABLED=false
SIGNICAT_ISSUER_URL=https://<signicat-sandbox-domain>/auth/open
SIGNICAT_CLIENT_ID=<signicat-client-id>
SIGNICAT_CLIENT_SECRET=<signicat-client-secret>
SIGNICAT_REDIRECT_URI=http://localhost:5173/api/auth/mitid/callback
SIGNICAT_PRIVATE_SCOPES=openid profile mitid-extra
SIGNICAT_BUSINESS_SCOPES=openid profile mitid-extra mitid-business
