model Document {
  uuid          String       @id @default(cuid())
  name          String
  documentType  DocumentType
  url           String
  date          DateTime     @default(now())
  applicationId String       @unique
  application   Application  @relation(fields: [applicationId], references: [caseNumber])
  signPlanId    String       @unique
  signPlan      SignPlan     @relation(fields: [signPlanId], references: [uuid])
}
