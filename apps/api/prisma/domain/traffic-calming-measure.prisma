model TrafficCalmingMeasure {
  id              String                     @id @default(uuid())
  type            TrafficCalmingMeasureType
  protectionLevel String
  scope           TrafficCalmingMeasureScope
  description     String
  applicationId   String
  application     Application                @relation(fields: [applicationId], references: [caseNumber])

  @@index([applicationId])
}
