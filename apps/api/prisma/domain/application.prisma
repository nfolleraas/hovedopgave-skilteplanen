model Application {
  caseNumber             String                  @id
  title                  String
  applicantReference     String
  type                   ApplicationType
  contactPersons         ContactPerson[]
  feedbacks              Feedback[]
  trafficCalmingMeasures TrafficCalmingMeasure[]
  signPlans              SignPlan[]
  documents              Document[]
  areas                  Area[]
  applicantId            String                  @unique
  applicant              Applicant               @relation(fields: [applicantId], references: [uuid])
  caseWorkerId           String?                 @unique
  caseWorker             CaseWorker?             @relation(fields: [caseWorkerId], references: [employeeNumber])
  roadUsePermitId        String                  @unique
  roadUsePermit          RoadUsePermit           @relation(fields: [roadUsePermitId], references: [caseNumber])
  excavationPermitId     String                  @unique
  excavationPermit       ExcavationPermit        @relation(fields: [excavationPermitId], references: [caseNumber])
}
