model Area {
  uuid                   String        @id @default(uuid())
  roadName               String
  roadOwnership          RoadOwnership
  postalCode             String
  houseNumberTo          String?
  houseNumberFrom        String?
  alternativeDescription String?
  // Optional because event applications only register the road itself.
  areaDetailId           String?       @unique
  areaDetail             AreaDetail?   @relation(fields: [areaDetailId], references: [uuid])
  areaSizeId             String?       @unique
  areaSize               AreaSize?     @relation(fields: [areaSizeId], references: [uuid])
  // Not unique: an application can have several areas.
  applicationId          String
  application            Application   @relation(fields: [applicationId], references: [caseNumber])
}
