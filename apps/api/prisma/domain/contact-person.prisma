model ContactPerson {
  uuid          String       @id @default(cuid())
  name          String
  email         String
  phoneNumber   String
  availability  Availability
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [caseNumber])
  actorId         String       @unique
  actor         Actor        @relation(fields: [actorId], references: [uuid])
}
