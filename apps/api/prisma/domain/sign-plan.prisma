model SignPlan {
  uuid          String       @id @default(cuid())
  name          String
  documentType  DocumentType
  url           String
  date          DateTime     @default(now())
  signPlanType  SignPlanType
  group         String
  plan          String
  applicationId String       @unique
  application   Application  @relation(fields: [applicationId], references: [caseNumber])
  document      Document?
  documentUuid  String?
}
