model RoadUsePermit {
  caseNumber       String       @id
  applicationId    String       @unique
  application      Application  @relation(fields: [caseNumber], references: [caseNumber], onDelete: Cascade)
  isEvent          Boolean
  startDate        DateTime
  endDate          DateTime
  eventStart       DateTime
  eventEnd         DateTime
  usage            Usage
  usageDescription String?
  materials        Material[]
  permissions      Permission[]
}
