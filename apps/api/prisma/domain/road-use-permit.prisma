model RoadUsePermit {
  caseNumber         String          @id
  title              String
  applicantReference String
  type               ApplicationType
  isEvent            Boolean
  startDate          DateTime
  endDate            DateTime
  eventStart         DateTime
  eventEnd           DateTime
  usage              Usage
  usageDescription   String?
  trafficChange      TrafficChange
  materials          Material[]
  permissions        Permission[]
  application        Application?
}
